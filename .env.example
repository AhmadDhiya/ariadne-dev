# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK PERNAH di-commit.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env

# Password database lokal. Pakai huruf dan angka saja (tanpa ; atau spasi), minimal 16 karakter.
POSTGRES_PASSWORD=

# Development = data contoh + tanggal demo 28 Sep 2026.
# Production  = untuk server sungguhan (tanpa data contoh, tanpa tanggal palsu).
ASPNETCORE_ENVIRONMENT=Development

# OPSIONAL. Isi hanya bila ingin data contoh dari mockup (Ahmad, Wiwiet, dst.; email nama@perusahaan.co.id,
# semuanya memakai password ini; minimal 12 karakter). Kosongkan untuk mulai dari database kosong.
# Hanya dipakai bila ASPNETCORE_ENVIRONMENT=Development dan database belum punya pengguna.
SEED_PASSWORD=

# Alamat aplikasi untuk tautan di email (reset password). Untuk mode "dotnet run + npm run dev" pakai
# http://localhost:5173. Di server, isi alamat sebenarnya.
APP_BASE_URL=http://localhost:18080

# Admin pertama untuk database kosong (lokal maupun server). Tanpa ini aplikasi yang baru dipasang tidak
# punya cara masuk. Password minimal 12 karakter. Diabaikan sama sekali bila sudah ada pengguna.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Nama yang tampil untuk admin pertama (kosong = "Admin")
BOOTSTRAP_ADMIN_NAME=

# Port di komputer ini (semua hanya terbuka untuk komputer ini). Ganti bila bentrok dengan program lain.
# WEB_PORT=18080
# DB_PORT=54321
# MAILPIT_WEB_PORT=18025
# MAILPIT_SMTP_PORT=10251
