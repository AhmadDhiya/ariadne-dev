# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK PERNAH di-commit.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env

# Password database lokal. Pakai huruf dan angka saja (tanpa ; atau spasi), minimal 16 karakter.
POSTGRES_PASSWORD=

# Development = data contoh + tanggal demo 28 Sep 2026.
# Production  = untuk server sungguhan (tanpa data contoh, tanpa tanggal palsu).
ASPNETCORE_ENVIRONMENT=Development
