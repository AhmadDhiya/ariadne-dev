# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK PERNAH di-commit.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env

# Password database lokal. Pakai huruf dan angka saja (tanpa ; atau spasi), minimal 16 karakter.
POSTGRES_PASSWORD=

# Development = data contoh + tanggal demo 28 Sep 2026.
# Production  = untuk server sungguhan (tanpa data contoh, tanpa tanggal palsu).
ASPNETCORE_ENVIRONMENT=Development

# Password untuk SEMUA akun contoh (Ahmad, Wiwiet, dst.; email nama@perusahaan.co.id). Wajib diisi agar
# data contoh dibuat; minimal 12 karakter. Hanya dipakai bila ASPNETCORE_ENVIRONMENT=Development.
SEED_PASSWORD=

# Alamat aplikasi untuk tautan di email (reset password). Untuk mode "dotnet run + npm run dev" pakai
# http://localhost:5173. Di server, isi alamat sebenarnya.
APP_BASE_URL=http://localhost:18080

# Admin pertama untuk database kosong, mis. saat pertama dipasang di server. Kosongkan bila tidak dipakai.
# Diabaikan sama sekali bila sudah ada pengguna.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
